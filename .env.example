# RideCloud — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne committez jamais .env.local : il contient des secrets.

# --- Supabase (côté client + serveur) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase (côté serveur uniquement, JAMAIS exposé au client) ---
# Nécessaire pour la suppression de compte (RGPD art. 17), opérations d'admin.
# Récupération : Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- Mollie (paiements, côté serveur uniquement) ---
# Test key (test_xxx) pour le développement, live key (live_xxx) pour la production.
# Récupération : Mollie Dashboard → Developers → API keys
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Mistral AI (génération des plans d'entretien personnalisés, côté serveur uniquement) ---
# Réservé aux abonnés Premium et Family. Coût indicatif : ~0,002 €/véhicule.
# Récupération : https://console.mistral.ai → API Keys
MISTRAL_API_KEY=
# Optionnel : modèle Mistral utilisé (défaut : mistral-small-latest)
# Autres choix : mistral-medium-latest (plus précis, plus cher), open-mistral-7b (économique)
MISTRAL_MODEL=mistral-small-latest
