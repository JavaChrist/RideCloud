# RideCloud — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne committez jamais .env.local : il contient des secrets.

# --- Supabase (côté client + serveur) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase (côté serveur uniquement, JAMAIS exposé au client) ---
# Nécessaire pour la suppression de compte (RGPD art. 17), opérations d'admin.
# Récupération : Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- Mollie (paiements web, côté serveur uniquement) ---
# Test key (test_xxx) pour le développement, live key (live_xxx) pour la production.
# Récupération : Mollie Dashboard → Developers → API keys
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Play Billing (abonnements Android, côté serveur uniquement) ---
# Compte de service avec accès Android Publisher API + Play Console (app RideCloud).
# JSON brut ou base64. Alternative : CLIENT_EMAIL + PRIVATE_KEY (\\n échappés).
# Produits Play Console (abonnements, sans essai) :
#   ridecloud_premium_monthly / ridecloud_premium_yearly
#   ridecloud_family_monthly / ridecloud_family_yearly
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# GOOGLE_PLAY_CLIENT_EMAIL=
# GOOGLE_PLAY_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=fr.javachrist.ridecloud

# --- Mistral AI (génération des plans d'entretien personnalisés, côté serveur uniquement) ---
# Réservé aux abonnés Premium et Family. Coût indicatif : ~0,002 €/véhicule.
# Récupération : https://console.mistral.ai → API Keys
MISTRAL_API_KEY=
# Optionnel : modèle Mistral utilisé (défaut : mistral-small-latest)
# Autres choix : mistral-medium-latest (plus précis, plus cher), open-mistral-7b (économique)
MISTRAL_MODEL=mistral-small-latest

# --- Web Push (VAPID) ---
# Générer : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:support@javachrist.fr

# --- Firebase Cloud Messaging (serveur uniquement, JAMAIS NEXT_PUBLIC_*) ---
# Compte de service Firebase → Vercel Project → Settings → Environment Variables
# FIREBASE_PRIVATE_KEY : conserver les \n échappés sur une seule ligne
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Crons (sécurité) ---
# Token secret vérifié par /api/cron/*. Générer : openssl rand -hex 32
CRON_SECRET=

# --- Admin ---
# Liste d'emails admin séparés par une virgule (accès /admin/*)
ADMIN_EMAILS=support@javachrist.fr

# --- Beta Club JavaChrist (invitation Discord publique uniquement) ---
# Lien discord.gg/… ou discord.com/invite/… — pas un lien de salon /channels/…
# Une invitation par défaut est aussi définie dans src/lib/beta-club.ts.
NEXT_PUBLIC_JAVACHRIST_DISCORD_INVITE=https://discord.gg/7mD8UgBGv4
