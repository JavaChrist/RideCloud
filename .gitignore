cat > .gitignore <<'EOF'
# dependencies
node_modules/

# next.js
.next/
out/

# env
.env.local
.env*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os/editor
.DS_Store
Thumbs.db
.vscode/
EOF
.vercel

# supabase CLI
supabase/.temp/

# Firebase Android (ne jamais committer)
google-services.json
**/google-services.json

# Android upload key / signature Release (ne jamais committer)
*.jks
*.keystore
keystore.properties
key.properties
**/keystore.properties
**/key.properties
